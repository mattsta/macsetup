# macsetup-template-block: env
export EDITOR=nvim
export VISUAL=nvim
export PAGER='less -FRX'
export LESS='-R'
export BAT_PAGER='less -FRX'
unset GIT_PAGER
unset NO_COLOR
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export ZSH_DISABLE_COMPFIX=true

# macsetup-template-block: history
# NOTE: share_history is intentionally unset in the "options" block below, which
# runs AFTER oh-my-zsh is sourced. oh-my-zsh's lib/history.zsh runs
# `setopt share_history`, so unsetting it here (before that source) would be a no-op.
if [[ -o interactive ]]; then
  autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
  zmodload zsh/terminfo 2>/dev/null || true
  if [[ -n ${terminfo[kcuu1]:-} ]]; then
    bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
  fi
  if [[ -n ${terminfo[kcud1]:-} ]]; then
    bindkey "${terminfo[kcud1]}" down-line-or-beginning-search
  fi
  bindkey '^[[A' up-line-or-beginning-search
  bindkey '^[[B' down-line-or-beginning-search
  bindkey '^[OA' up-line-or-beginning-search
  bindkey '^[OB' down-line-or-beginning-search
fi

# macsetup-template-block: oh-my-zsh
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="${ZSH_THEME:-kphoen}"
plugins=(git)
if [[ -r "$ZSH/oh-my-zsh.sh" ]] && ! typeset -f omz >/dev/null 2>&1; then
  source "$ZSH/oh-my-zsh.sh"
fi
unalias -m 'g*' >/dev/null 2>&1 || true

# macsetup-template-block: options
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushdminus
setopt complete_in_word
setopt always_to_end
setopt menu_complete
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt interactive_comments
setopt long_list_jobs
setopt prompt_subst
unsetopt flow_control
unsetopt share_history

# macsetup-template-block: aliases
alias ls="gls --color=auto"
alias moretty="sudo sysctl -w kern.tty.ptmx_max=768"
alias nolo='exiftool -GPSLongitude= -GPSLatitude='
alias po=poetry
alias goodnight='pmset displaysleepnow'
alias pi='echo "scale=60; 4*a(1)" | bc -lq'
alias vim=nvim
alias ip=ipython
alias cat='bat'
alias ccat='command cat'
alias batp='bat --paging=always'

# macsetup-template-block: optional-tools
if [[ -d "$HOME/bin" ]]; then
  export PATH="$HOME/bin:$PATH"
fi

if [[ -d "$HOME/.bun/bin" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

if [[ -d /opt/homebrew/opt/openjdk/bin ]]; then
  export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
fi

if [[ -d /opt/homebrew/opt/llvm/bin ]]; then
  export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
fi

if [[ -r "$HOME/.config/broot/launcher/bash/br" ]]; then
  source "$HOME/.config/broot/launcher/bash/br"
fi

export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-262144}"

# macsetup-template-block: completions
if [[ ${EUID:-$(id -u)} -ne 0 ]] && command -v brew >/dev/null 2>&1; then
  FPATH="$(brew --prefix)/share/zsh-completions:$FPATH"
  autoload -Uz compinit
  compinit
fi

# macsetup-template-block: pyenv
export PYENV_ROOT="$HOME/.pyenv"
if [[ -d "$PYENV_ROOT/bin" ]]; then
  export PATH="$PYENV_ROOT/bin:$PATH"
fi

if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - zsh --no-rehash)"
fi

# macsetup-template-block: prompt
# The kphoen Oh My Zsh theme owns PROMPT/RPROMPT and git prompt formatting.
# Keep this block managed so older macsetup prompt overrides are replaced.

# macsetup-template-block: functions
function toImgs() {
    ffmpeg -i "$1" -r 7 -qscale:v 2 "$2"-%0000d.jpg
}

function note() {
    note_name=""
    if [[ ! -z "$*" ]]; then
        note_name="-${*// /-}"
    fi
    nvim $(date "+%Y-%m-%d")$note_name.md
}

function ccd() {
    mkdir -p "$1"
    cd "$1"
}

unalias l >/dev/null 2>&1 || true
function l()  {
     echo "scale=10; l($1)/l(2)" | bc -lq
}

function 2x()  {
    echo "2^$1" | bc -lq
}

function e()  {
    echo "e($1)" | bc -lq
}

function y() {
    while ! yt-dlp --embed-chapters --embed-thumbnail --embed-subs \
                   --no-mtime --socket-timeout 2 "$@"; do
        echo DISCONNECTED
        sleep 5
    done
}

function dvrEncode() {
    local input="$1"
    local outdir="$2"
    local outname
    outname="$(basename "${input:r}.mp4")"

    ffmpeg -i "$input" -c copy -c:a aac "$outdir/$outname"
}
